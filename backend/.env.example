# EOT Delay Assistant — Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit .env to GitHub

# AI API Keys (at least one recommended — all are free)
# Get Gemini key free at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_key_here

# Get Groq key free at: https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# OllamaFreeAPI — no key needed, community servers used automatically

# Server
PORT=3001
